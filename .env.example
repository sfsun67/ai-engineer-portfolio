# AstralWeave LLM API Configuration
# Copy this file to .env and fill in your values

# API base URL — leave EMPTY in dev (requests go through Vite proxy, no CORS issues)
# Only set this for production builds where frontend and backend share the same domain
VITE_API_BASE_URL=

# Vite dev server proxy target — the actual backend URL
# This is used by the Vite dev server only, NOT exposed to the browser
VITE_API_PROXY_TARGET=https://your-backend-domain.com

# Instance credentials for HMAC signature authentication
VITE_INSTANCE_ID=
VITE_INSTANCE_TOKEN=
